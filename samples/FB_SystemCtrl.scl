FUNCTION_BLOCK "FB_系统控制"
VERSION : 0.1
VAR_INPUT
    b按钮A : Bool;       // 按下:大、小圆盘电机使能
    b按钮B : Bool;       // 单击:小圆盘顺时针旋转60度后停止
    b按钮C : Bool;       // 单击:大、小圆盘同时回零点
    b按钮D : Bool;       // 单击:小圆盘箭头自动转至大圆盘箭头位置后同步
    b按钮E : Bool;       // 单击:大圆盘继续旋转,小圆盘停止
    b按钮F : Bool;       // 单击:启用/停用软限位功能
    b开关DI1 : Bool;     // 按下:大圆盘顺时针旋转;抬起:停止
    b开关DI2 : Bool;     // 按下:大圆盘逆时针旋转;抬起:停止
    b优化命令 : Bool;    // 按下:大、小圆盘电机优化(各转60度)
    b报警复位 : Bool;    // 复位已确认的工艺报警
    r转速设定 : Real;    // 大圆盘转速设定(rpm)
    r限位值 : Real;      // 软限位位置(度,默认1800)
END_VAR

VAR_OUTPUT
    q灯H1 : Bool := FALSE;        // 运行指示灯H1:运行状态点亮
    q优化完成 : Bool := FALSE;    // 两轴优化均完成
    i工艺报警号 : Int;   // 工艺报警号:1=软限位 2=超速
    r大盘位置 : Real := 0.0;    // 大圆盘位置(度)
    r大盘速度 : Real := 0.0;    // 大圆盘实际转速(rpm)
    r小盘位置 : Real := 0.0;    // 小圆盘位置(度)
    r小盘速度 : Real := 0.0;    // 小圆盘实际转速(rpm)
END_VAR

VAR
    fb大盘 : "FB_MotorCtrl";    // 大圆盘轴实例
    fb小盘 : "FB_MotorCtrl";    // 小圆盘轴实例
    b使能保持 : Bool;           // 按钮A使能保持
    b优化中 : Bool;             // 优化进行中
    b优化完成大 : Bool;         // 大盘优化完成
    b优化完成小 : Bool;         // 小盘优化完成
    b定位请求小 : Bool;         // 小盘定位请求(按钮B,到位后清除)
    b同步使能 : Bool;           // 同步模式使能(按钮D置位,按钮E复位)
    b软限位使能 : Bool;         // 软限位启用状态(按钮F切换)
    b回零触发 : Bool;           // 回零命令上升沿(按钮C)
END_VAR

BEGIN
    // =====================================================================
    // 输入逻辑
    // =====================================================================
    // 按钮A:使能保持
    IF b按钮A THEN
        b使能保持 := TRUE;
    END_IF;

    // 优化:运行前执行,两轴各转60度
    IF b优化命令 THEN
        b优化中 := TRUE;
        b优化完成大 := FALSE;
        b优化完成小 := FALSE;
    END_IF;

    // 按钮B:小盘定位请求(60度),到位后清除
    IF b按钮B AND NOT b优化中 AND NOT b同步使能 THEN
        b定位请求小 := TRUE;
    END_IF;

    // 按钮D:进入同步模式(小盘跟随大盘)
    IF b按钮D AND NOT b优化中 THEN
        b同步使能 := TRUE;
    END_IF;

    // 按钮E:解除同步
    IF b按钮E THEN
        b同步使能 := FALSE;
    END_IF;

    // 按钮F:软限位使能切换(电平反转需上升沿,此处简化为按下切换)
    IF b按钮F THEN
        b软限位使能 := NOT b软限位使能;
    END_IF;

    // 按钮C:回零触发
    IF b按钮C THEN
        b回零触发 := TRUE;
        b同步使能 := FALSE;
    END_IF;

    // =====================================================================
    // 大圆盘轴:单次调用(SCL 规则:一个实例只能调用一次,输入用表达式组合)
    // =====================================================================
    fb大盘(b使能 := b使能保持 OR b优化中 OR b回零触发,
           b正转命令 := b开关DI1 AND NOT b开关DI2 AND NOT b优化中,
           b反转命令 := b开关DI2 AND NOT b开关DI1 AND NOT b优化中,
           b定位命令 := b优化中 AND NOT b优化完成大,
           b回零命令 := b回零触发,
           b同步模式 := FALSE,
           r速度设定 := r转速设定,
           r目标角度 := 60.0,           // 优化定位角度
           r同步目标 := 0.0,
           b软限位使能 := b软限位使能,
           r软限位值 := r限位值,
           r最大速度 := 6000.0);         // 伺服额定转速上限

    // =====================================================================
    // 小圆盘轴:单次调用
    // =====================================================================
    fb小盘(b使能 := b使能保持 OR b优化中 OR b回零触发,
           b正转命令 := FALSE,
           b反转命令 := FALSE,
           b定位命令 := (b优化中 AND NOT b优化完成小) OR b定位请求小,
           b回零命令 := b回零触发,
           b同步模式 := b同步使能,
           r速度设定 := r转速设定,
           r目标角度 := 60.0,           // 优化/按钮B 定位角度
           r同步目标 := fb大盘.r位置,    // 同步:小盘跟随大盘位置
           b软限位使能 := b软限位使能,
           r软限位值 := r限位值,
           r最大速度 := 6000.0);

    // =====================================================================
    // 输出处理
    // =====================================================================
    // 优化完成判断
    IF b优化中 AND fb大盘.q到位 AND fb小盘.q到位 THEN
        b优化完成大 := TRUE;
        b优化完成小 := TRUE;
        b优化中 := FALSE;
    END_IF;

    // 小盘定位请求清除(按钮B定位完成)
    IF b定位请求小 AND fb小盘.q到位 THEN
        b定位请求小 := FALSE;
    END_IF;

    // 回零触发清除(两轴回零完成)
    IF b回零触发 AND fb大盘.q回零完成 AND fb小盘.q回零完成 THEN
        b回零触发 := FALSE;
    END_IF;

    // 报警汇总
    i工艺报警号 := 0;
    IF fb大盘.q报警 THEN
        i工艺报警号 := fb大盘.i报警号;
    END_IF;
    IF fb小盘.q报警 THEN
        i工艺报警号 := fb小盘.i报警号;
    END_IF;
    // 报警复位(需报警条件已消失)
    IF b报警复位 AND NOT fb大盘.q报警 AND NOT fb小盘.q报警 THEN
        i工艺报警号 := 0;
    END_IF;

    // 指示灯H1:使能或运行状态点亮
    q灯H1 := b使能保持 OR b优化中 OR fb大盘.q运行 OR fb小盘.q运行;

    // HMI 显示数据
    r大盘位置 := fb大盘.r位置;
    r大盘速度 := fb大盘.r速度;
    r小盘位置 := fb小盘.r位置;
    r小盘速度 := fb小盘.r速度;

    q优化完成 := b优化完成大 AND b优化完成小;
END_FUNCTION_BLOCK
