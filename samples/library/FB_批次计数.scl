FUNCTION_BLOCK "FB_批次计数"
VERSION : 0.1
VAR_INPUT
    b计数 : Bool;                  // 计数脉冲(上升沿计数)
    b复位 : Bool;                  // 计数清零(不清批次号)
    i目标 : Int := 10;             // 每批目标数量
    b批次确认 : Bool;              // 确认批次完成(换批)
END_VAR

VAR_OUTPUT
    i当前 : Int := 0;              // 当前批已计数
    i批次号 : Int := 0;            // 已完成批次号
    q批次完成 : Bool := FALSE;     // 本批达到目标
END_VAR

VAR
    b上次 : Bool;                  // 输入上次状态(上升沿检测)
    i当前缓存 : Int := 0;          // 当前批计数(静态,输出映射用)
    i批次缓存 : Int := 0;          // 批次号计数(静态)
END_VAR

VAR_TEMP
    i增计数 : Int;                 // 计数增量(1/0)
    i增换批 : Int;                 // 换批增量(1/0)
END_VAR

BEGIN
    // 上升沿检测 → 增量
    IF b计数 AND NOT b上次 THEN
        i增计数 := 1;
    ELSE
        i增计数 := 0;
    END_IF;
    b上次 := b计数;

    // 静态缓存累加(输出参数禁止"先读后写",否则触发未初始化警告)
    i当前缓存 := i当前缓存 + i增计数;

    // 复位
    IF b复位 THEN
        i当前缓存 := 0;
    END_IF;

    // 批次完成判断(布尔表达式直接赋值)
    q批次完成 := (i当前缓存 >= i目标);

    // 确认换批:批次号 +1,开始新一批
    IF b批次确认 AND q批次完成 THEN
        i增换批 := 1;
        i当前缓存 := 0;
    ELSE
        i增换批 := 0;
    END_IF;
    i批次缓存 := i批次缓存 + i增换批;

    // 输出映射
    i当前 := i当前缓存;
    i批次号 := i批次缓存;
END_FUNCTION_BLOCK
