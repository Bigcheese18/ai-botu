FUNCTION_BLOCK "FB_传送带分拣"
VERSION : 0.1
VAR_INPUT
    b运行 : Bool;              // 传送带运行命令
    b停止 : Bool;              // 停止命令
    b入口传感器 : Bool;        // 入口计数传感器(上升沿计数)
    b分拣位1 : Bool;           // 1 号分拣位(推杆前方有物料)
    b分拣位2 : Bool;           // 2 号分拣位
    b推杆1复位 : Bool;         // 1 号推杆复位到位(可推)
    b推杆2复位 : Bool;         // 2 号推杆复位到位
    b复位 : Bool;              // 计数清零
END_VAR

VAR_OUTPUT
    q皮带 : Bool;              // 皮带电机输出
    q推杆1 : Bool;             // 1 号分拣推杆
    q推杆2 : Bool;             // 2 号分拣推杆
    i总数 : Int := 0;          // 已通过物料总数
    i分拣1数 : Int := 0;       // 分拣到 1 号的数量
    i分拣2数 : Int := 0;       // 分拣到 2 号的数量
END_VAR

VAR
    b皮带自锁 : Bool;          // 皮带运行自锁
    b上次传感器 : Bool;        // 传感器上次状态(上升沿检测)
    b上次推杆1 : Bool;         // 推杆1 上次状态(上升沿检测)
    b上次推杆2 : Bool;         // 推杆2 上次状态(上升沿检测)
    b奇偶 : Bool := FALSE;     // 奇偶轮转:奇数去 1 号,偶数去 2 号
    i总数缓存 : Int := 0;      // 总数计数(静态,输出映射用)
    i分拣1缓存 : Int := 0;     // 分拣1 计数
    i分拣2缓存 : Int := 0;     // 分拣2 计数
END_VAR

VAR_TEMP
    i增入口 : Int;             // 入口计数增量
    i增推杆1 : Int;            // 推杆1 计数增量
    i增推杆2 : Int;            // 推杆2 计数增量
END_VAR

BEGIN
    // 皮带启停自锁
    b皮带自锁 := (b运行 OR b皮带自锁) AND NOT b停止;
    q皮带 := b皮带自锁;

    // 入口计数:上升沿 → 增量,奇偶轮转
    IF b入口传感器 AND NOT b上次传感器 THEN
        i增入口 := 1;
        b奇偶 := NOT b奇偶;
    ELSE
        i增入口 := 0;
    END_IF;
    b上次传感器 := b入口传感器;

    // 分拣:物料到达对应分拣位且推杆复位 → 推出
    q推杆1 := b皮带自锁 AND b奇偶 AND b分拣位1 AND b推杆1复位;
    q推杆2 := b皮带自锁 AND NOT b奇偶 AND b分拣位2 AND b推杆2复位;

    // 分拣计数:推杆动作上升沿 → 增量
    IF q推杆1 AND NOT b上次推杆1 THEN
        i增推杆1 := 1;
    ELSE
        i增推杆1 := 0;
    END_IF;
    b上次推杆1 := q推杆1;
    IF q推杆2 AND NOT b上次推杆2 THEN
        i增推杆2 := 1;
    ELSE
        i增推杆2 := 0;
    END_IF;
    b上次推杆2 := q推杆2;

    // 静态缓存累加(输出参数禁止"先读后写",否则触发未初始化警告)
    i总数缓存 := i总数缓存 + i增入口;
    i分拣1缓存 := i分拣1缓存 + i增推杆1;
    i分拣2缓存 := i分拣2缓存 + i增推杆2;

    // 总清零
    IF b复位 THEN
        i总数缓存 := 0;
        i分拣1缓存 := 0;
        i分拣2缓存 := 0;
        b奇偶 := FALSE;
    END_IF;

    // 输出映射
    i总数 := i总数缓存;
    i分拣1数 := i分拣1缓存;
    i分拣2数 := i分拣2缓存;
END_FUNCTION_BLOCK
