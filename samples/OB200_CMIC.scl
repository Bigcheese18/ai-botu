ORGANIZATION_BLOCK "OB200"
VERSION : 0.1
BEGIN
    // =====================================================================
    // CMIC 圆盘同步控制系统:调用 FB_系统控制(背景 DB: inst_系统控制),
    // 接口连接全局变量表(按钮 A-F 来自 HMI 触摸屏;DI1/DI2 为 PLC 输入;
    // 显示变量供 HMI 读取)。需先创建背景 DB: inst_系统控制
    // 注意:本 OB 需挂入循环扫描(OB1 中调用,或加入 OB1 的调用列表)
    // =====================================================================
    "inst_系统控制"(b按钮A := "按钮A",        // HMI 按钮 A:大、小圆盘电机使能
           b按钮B := "按钮B",        // HMI 按钮 B:小圆盘顺时针旋转60度
           b按钮C := "按钮C",        // HMI 按钮 C:大、小圆盘同时回零点
           b按钮D := "按钮D",        // HMI 按钮 D:小圆盘转至大圆盘位置后同步
           b按钮E := "按钮E",        // HMI 按钮 E:解除同步,小圆盘停止
           b按钮F := "按钮F",        // HMI 按钮 F:软限位使能切换
           b开关DI1 := "DI1",        // 开关 DI1:大圆盘正转
           b开关DI2 := "DI2",        // 开关 DI2:大圆盘反转
           b优化命令 := "优化命令",  // 优化:两轴各转60度
           b报警复位 := "报警复位",  // 报警复位确认
           r转速设定 := "大盘转速设定",   // HMI 设定窗口写入(rpm)
           r限位值 := 1800.0,             // 软限位 ±1800 度
           q灯H1 => "指示灯H1",           // 运行指示灯
           i工艺报警号 => "工艺报警号",   // 工艺报警号(1=软限位 2=超速)
           r大盘位置 => "大盘位置",
           r大盘速度 => "大盘转速",
           r小盘位置 => "小盘位置",
           r小盘速度 => "小盘转速");
END_ORGANIZATION_BLOCK
